# Optional. Defaults to the private per-user application data directory.
HAYVOZ_DATA_DIR=
HAYVOZ_LANGUAGE=es

# Recording backend: avfoundation, dshow, pulse or alsa.
HAYVOZ_FFMPEG=ffmpeg
HAYVOZ_AUDIO_BACKEND=avfoundation
HAYVOZ_AUDIO_DEVICE=0

# Optional OpenAI integration credentials. Keep real values only in private config.env.
HAYVOZ_AI_PROVIDER=openai
HAYVOZ_AI_API_KEY=
HAYVOZ_AI_MODEL=
HAYVOZ_AI_BASE_URL=
HAYVOZ_AI_TIMEOUT_SECONDS=60

# Assistant batching. Chunks are deliberately restricted to 10-20 seconds.
ASSISTANT_CHUNK_SECONDS=15
ASSISTANT_ANALYSIS_INTERVAL_SECONDS=60
ASSISTANT_LAST_SEGMENTS=20

# Local transcription. large is intentionally unsupported.
WHISPER_MODEL=small
WHISPER_LANGUAGE=
WHISPER_CPU_THREADS=4
WHISPER_BEAM_SIZE=1
WHISPER_VAD=true
